# Heavy pre-decimation meshes from the image-to-3D pipeline (regenerable).
# Keep the decimated *.glb that the game actually loads; drop the raw ones.
assets/models/*_raw.glb
assets/models/*_tex_raw.glb
assets/models/.textured_done

# Intermediate rig backups (regenerable from the pipeline)
assets/models/*.bak.glb

# Python / tooling junk
__pycache__/
*.pyc

# Scratch
scratch_*.py
*.log
.claude/

# Build stamp — regenerated by serve.ps1 on every launch (local state, not source)
BUILD_INFO.json

# UniRig intermediate extract/skeleton npz (regenerable)
assets/models/ash_wyrm/
assets/models/base_m1.glb
