# Heavy pre-decimation meshes from the image-to-3D pipeline (regenerable).
# Keep the decimated *.glb that the game actually loads; drop the raw ones.
assets/models/*_raw.glb
assets/models/*_tex_raw.glb
assets/models/.textured_done

# Intermediate rig backups (regenerable from the pipeline)
assets/models/*.bak.glb

# Python / tooling junk
__pycache__/
*.pyc

# Scratch
scratch_*.py
*.log
.claude/

# Local Studio Safe Publish workspaces (snapshots, exports, backups, receipts)
.studio-workspaces/
.studio-publish.lock

# Build stamp — regenerated by serve.ps1 on every launch (local state, not source)
BUILD_INFO.json

# UniRig intermediate extract/skeleton npz (regenerable)
assets/models/ash_wyrm/
assets/models/base_m1.glb

# bulky local video candidates (kept on disk, not in history)
Maps/concepts/video/
node_modules/
package-lock.json

# Blender autosave backups
*.blend1

# scratch trial scenes and bulk music previews over 20 MB (kept on disk, not in history)
scratchpad/tut_props_batch.blend
scratchpad/wolf_soldier_batch.blend
scratchpad/v07_town_guard.blend
scratchpad/mixar_giant_mole_trial_2026-07-07.blend
scratchpad/mixar_room_trial_2026-07-07.blend
music_previews/crafted_realm_echoes_collection.zip
music_previews/crafted_realm_echoes/echoes_of_the_old_roads_full_album.mp3
